# Build context is claude_code/. Exclude host build artifacts so the image
# build always installs and compiles fresh instead of copying host-platform
# binaries (e.g. esbuild) or stale output over what `npm ci`/`npm run build`
# produce inside the image.
app/node_modules
app/dist
app/.build-test
# Test sources have no build or runtime purpose in the image: `npm run build`
# is build:server + build:web, neither of which reads test/.
app/test
